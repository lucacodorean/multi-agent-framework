# Context is the repository root. Keep this next to the platform Dockerfile so
# T2's engine build is unaffected (BuildKit uses <Dockerfile>.dockerignore).

.git
.github
.ddev
.claude
.grok

docs
engine

# All of infra/ is excluded, then ONLY this runtime's own directory is re-admitted; the
# ignore file is Dockerfile-scoped, so no other build is affected
# (docs/topology/preview.md § Rules, docs/architecture.md § Runtimes).
infra
!infra/deploy/platform

node_modules
/vendor
tests

# Host-generated / runtime — rebuilt in the image.
storage
bootstrap/cache/*
!bootstrap/cache/.gitignore
public/build
public/hot
public/storage
public/css/filament
public/js/filament
public/fonts/filament
public/fonts-manifest.dev.json

.env
.env.*
!.env.example
*.md
.phpunit.cache
.phpunit.result.cache
.phpactor.json
.idea
.vscode
.DS_Store
