# Env contract for infra/deploy/compose.yaml (Compose project oir-flow-preview).
# Not the DDEV `.env`. Copy to `infra/deploy/.env` before a later `up` — this cut
# does not boot the stack. `infra/deploy/.env` is gitignored; this file is not.
#
# Interpolation: `docker compose -f infra/deploy/compose.yaml --env-file infra/deploy/.env.example …`
# Compose also auto-loads `infra/deploy/.env` when that file exists.
#
# Secrets stay empty here. The DDEV ENGINE_KEY (`dev-only-insecure-engine-key`)
# must never be copied into this topology.

APP_NAME="OIR Flow"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost
APP_LOCALE=ro
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Cookie Secure flag — required now that web is HTTPS-only.
SESSION_SECURE_COOKIE=true
# CN / SAN for the self-signed cert start-web generates when no files are
# mounted at /var/lib/oir-flow/tls. Use the hostname (or IP) clients type.
TLS_HOSTNAME=localhost

# Database — Compose service `db` (postgres:16). `central` is the default
# connection in config/database.php. Compose maps these onto POSTGRES_*.
DB_CONNECTION=central
DB_HOST=db
DB_PORT=5432
DB_DATABASE=oir_flow
DB_USERNAME=oir_flow
DB_PASSWORD=
# Host publish of Postgres (0.0.0.0:DB_HOST_PORT → container 5432). The app
# still talks to DB_HOST=db:5432. Requires a real DB_PASSWORD when this port
# is reachable from outside the VM.
DB_HOST_PORT=5432

# Redis — Compose service `redis` (redis:7.4.10-bookworm). Conf is bind-mounted
# from infra/shared/redis/redis.conf (`maxmemory-policy noeviction`). Cache uses
# logical DB 1; queues, sessions and locks share DB 0 (config/database.php).
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Engine — Compose service `engine`, unpublished. Empty ENGINE_KEY is the
# honest unconfigured default (NOT the DDEV dev key).
ENGINE_URL=http://engine:8000
ENGINE_KEY=

# Mail — Compose service `mailpit`. SMTP is internal :1025; UI is published
# on the host as :8025. MAIL_MAILER stays smtp, never `log`
# (infra/README.md § Deployment constraints).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_FROM_NAME="OIR Flow"

# Drivers that DDEV's root `.env.example` also pins to Redis. Laravel config
# defaults are database/file — omit these and the queue service is a no-op.
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
FILESYSTEM_DISK=local

# Must exceed queue:work --timeout=360 (config/queue.php default retry_after=90
# would release a still-running convertPdf job). Unused until a later `up`.
REDIS_QUEUE_RETRY_AFTER=400

LOG_CHANNEL=stack
LOG_LEVEL=info

# First console operator — the only way into /console on a fresh install.
# All three required by infra/deploy/up.sh (console:administrator always runs).
CONSOLE_ADMIN_EMAIL=
CONSOLE_ADMIN_NAME=
CONSOLE_ADMIN_PASSWORD=

# Shared password for StagingTenantsSeeder (oir-north-west / oir-south-west).
# Required by infra/deploy/up.sh. Never oirflow-dev (published DevTenantsSeeder
# secret). Empty here; set a real value in infra/deploy/.env. Passed into web
# and queue via compose x-platform-environment.
STAGING_SEED_PASSWORD=
LOGIN_THROTTLE_ENABLED=false
